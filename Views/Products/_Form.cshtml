@model OrderManagementSystem.Models.Product

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="ProductName">Product Name</label>
    <input asp-for="ProductName" class="form-control" />
    <span asp-validation-for="ProductName" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Category">Category</label>
    <input asp-for="Category" class="form-control" />
    <span asp-validation-for="Category" class="text-danger"></span>
</div>

<div class="row g-3">
    <div class="mb-3 col-md-6">
        <label asp-for="Price">Price (EGP)</label>
        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="mb-3 col-md-6">
        <label asp-for="Stock">Stock</label>
        <input asp-for="Stock" type="number" min="0" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>