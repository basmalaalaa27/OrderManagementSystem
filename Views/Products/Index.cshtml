@model IEnumerable<OrderManagementSystem.Models.Product>

@{
    ViewData["Title"] = "Products";
    var categories = (List<string>)ViewBag.Categories;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Products Management</h2>
        <small class="text-muted">Manage product inventory</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="d-flex flex-wrap align-items-center mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2 mb-2"
           placeholder="Search by name or category" style="min-width:260px" />
    <select name="category" class="form-select me-2 mb-2">
        <option value="">All Categories</option>
        @foreach (var c in categories)
        {
            <option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option>
        }
    </select>
    <button type="submit" class="btn btn-primary me-2 mb-2">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary mb-2">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductId</td>
            <td><strong>@p.ProductName</strong></td>
            <td>@p.Category</td>
            <td>EGP @p.Price.ToString("N2")</td>
            <td>@p.Stock</td>
            <td>
                @if (p.Stock == 0)
                {
                    <span class="badge bg-danger">Out of stock</span>
                }
                else if (p.Stock < 15)
                {
                    <span class="badge bg-warning text-dark">Low stock</span>
                }
                else
                {
                    <span class="badge bg-success">In stock</span>
                }
            </td>
            <td class="text-end" style="white-space:nowrap">
                <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@p.ProductId" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this product?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="7" class="text-center text-muted">No products found.</td></tr>
    }
    </tbody>
</table>
