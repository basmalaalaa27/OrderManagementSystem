@model IEnumerable<OrderManagementSystem.ViewModels.CustomerListItem>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Customers Management</h2>
        <small class="text-muted">Manage customer information</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Customer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="d-flex flex-wrap align-items-center mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2 mb-2"
           placeholder="Search by name or email" style="min-width:280px" />
    <button type="submit" class="btn btn-primary me-2 mb-2">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary mb-2">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Registered</th>
            <th>Orders</th>
            <th>Total Spending</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.CustomerId</td>
            <td><strong>@c.FullName</strong></td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>@c.RegistrationDate.ToString("yyyy-MM-dd")</td>
            <td>@c.TotalOrders</td>
            <td>EGP @c.TotalSpending.ToString("N2")</td>
            <td class="text-end" style="white-space:nowrap">
                <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this customer?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="8" class="text-center text-muted">No customers found.</td></tr>
    }
    </tbody>
</table>
