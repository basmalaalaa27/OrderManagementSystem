@model OrderManagementSystem.Models.Order

@{
    ViewData["Title"] = "Add Order";
    var statuses = (string[])ViewBag.Statuses;
}

<h2>Add Order</h2>
<hr />

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="mb-3 col-md-6">
            <label asp-for="CustomerId">Customer</label>
            <select asp-for="CustomerId" asp-items="(SelectList)ViewBag.Customers" class="form-select">
                <option value="">-- Select customer --</option>
            </select>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-6">
            <label asp-for="ProductId">Product</label>
            <select asp-for="ProductId" asp-items="(SelectList)ViewBag.Products" class="form-select">
                <option value="">-- Select product --</option>
            </select>
            <span asp-validation-for="ProductId" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3">
        <div class="mb-3 col-md-4">
            <label asp-for="Quantity">Quantity</label>
            <input asp-for="Quantity" type="number" min="1" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="OrderDate">Order Date</label>
            <input asp-for="OrderDate" type="date" class="form-control" />
            <span asp-validation-for="OrderDate" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status">Status</label>
            <select asp-for="Status" class="form-select">
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(s == Model.Status)">@s</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
