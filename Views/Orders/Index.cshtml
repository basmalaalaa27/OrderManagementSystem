@model IEnumerable<OrderManagementSystem.ViewModels.OrderListItem>

@{
    ViewData["Title"] = "Orders";
    var statuses = (string[])ViewBag.Statuses;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Orders Management</h2>
        <small class="text-muted">Track and manage customer orders</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Add Order</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="d-flex flex-wrap align-items-center mb-3">
    <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2 mb-2"
           placeholder="Search by customer or product" style="min-width:260px" />
    <select name="status" class="form-select me-2 mb-2">
        <option value="">All Statuses</option>
        @foreach (var s in statuses)
        {
            <option value="@s" selected="@(s == (string?)ViewBag.Status)">@s</option>
        }
    </select>
    <button type="submit" class="btn btn-primary me-2 mb-2">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary mb-2">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var o in Model)
    {
        var badge = o.Status switch
        {
            "Pending" => "bg-warning text-dark",
            "Shipped" => "bg-info",
            "Delivered" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
        <tr>
            <td>@o.OrderId</td>
            <td>@o.OrderDate.ToString("yyyy-MM-dd")</td>
            <td>@o.CustomerName</td>
            <td>@o.ProductName</td>
            <td>@o.Quantity</td>
            <td>EGP @o.Price.ToString("N2")</td>
            <td><strong>EGP @o.Total.ToString("N2")</strong></td>
            <td><span class="badge @badge">@o.Status</span></td>
            <td class="text-end" style="white-space:nowrap">
                <a asp-action="Edit" asp-route-id="@o.OrderId" class="btn btn-sm btn-primary">Edit</a>
                <form asp-action="Delete" asp-route-id="@o.OrderId" method="post" class="d-inline"
                      onsubmit="return confirm('Delete this order?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="9" class="text-center text-muted">No orders found.</td></tr>
    }
    </tbody>
</table>
