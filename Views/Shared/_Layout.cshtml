<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="Content-Language" content="en">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title>@ViewData["Title"] - Order Management System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, shrink-to-fit=no" />
    <meta name="description" content="Order Management System - customers, products, orders, dashboard and reports">
    <meta name="msapplication-tap-highlight" content="no">
    <link rel="icon" href="~/favicon.ico">
    <!--
    ArchitectUI HTML Theme Dashboard - v4.7.0
    Copyright 2026 DashboardPack (https://dashboardpack.com)
    Licensed under MIT (https://github.com/DashboardPack/architectui-html-theme-free/blob/master/LICENSE)
    -->
    <link rel="stylesheet" href="~/css/main.css">
</head>
<body>
    @{
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="app-container app-theme-white body-tabs-shadow fixed-sidebar fixed-header">
        <!-- Header -->
        <div class="app-header header-shadow">
            <div class="app-header__logo">
                <a asp-controller="Home" asp-action="Index" class="fw-bold fs-5 text-decoration-none text-primary">Order Management</a>
                <div class="header__pane ms-auto">
                    <div>
                        <button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
                            <span class="hamburger-box">
                                <span class="hamburger-inner"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="app-header__mobile-menu">
                <div>
                    <button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
                        <span class="hamburger-box">
                            <span class="hamburger-inner"></span>
                        </span>
                    </button>
                </div>
            </div>
            <div class="app-header__menu">
                <span>
                    <button type="button" class="btn-icon btn-icon-only btn btn-primary btn-sm mobile-toggle-header-nav">
                        <span class="btn-icon-wrapper">
                            <i class="fa fa-ellipsis-v fa-w-6"></i>
                        </span>
                    </button>
                </span>
            </div>
            <div class="app-header__content">
                <div class="app-header-left">
                    <ul class="header-menu nav">
                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Index" class="nav-link">
                                <i class="nav-link-icon fa fa-edit"></i>
                                Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Reports" asp-action="Index" class="nav-link">
                                <i class="nav-link-icon fa fa-database"></i>
                                Reports
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Settings" asp-action="Index" class="nav-link">
                                <i class="nav-link-icon fa fa-cog"></i>
                                Settings
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="app-header-right">
                    <div class="header-btn-lg pe-0">
                        <div class="widget-content p-0">
                            <div class="widget-content-wrapper">
                                <div class="widget-content-left">
                                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                        <i class="fa fa-user text-white"></i>
                                    </div>
                                </div>
                                <div class="widget-content-left ms-3 header-user-info">
                                    <div class="widget-heading">Admin User</div>
                                    <div class="widget-subheading">System Administrator</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="app-main">
            <!-- Sidebar -->
            <div class="app-sidebar sidebar-shadow">
                <div class="app-header__logo">
                    <a asp-controller="Home" asp-action="Index" class="fw-bold fs-5 text-decoration-none text-primary">Order Management</a>
                    <div class="header__pane ms-auto">
                        <div>
                            <button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
                                <span class="hamburger-box">
                                    <span class="hamburger-inner"></span>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="scrollbar-sidebar">
                    <div class="app-sidebar__inner">
                        <ul class="vertical-nav-menu">
                            <li class="app-sidebar__heading">Main Menu</li>
                            <li>
                                <a asp-controller="Home" asp-action="Index" class="@(current == "Home" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-rocket"></i>
                                    Dashboard
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Orders" asp-action="Index" class="@(current == "Orders" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-display2"></i>
                                    Orders
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Products" asp-action="Index" class="@(current == "Products" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-box2"></i>
                                    Products
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Customers" asp-action="Index" class="@(current == "Customers" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-users"></i>
                                    Customers
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Reports" asp-action="Index" class="@(current == "Reports" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-graph2"></i>
                                    Reports
                                </a>
                            </li>
                            <li>
                                <a asp-controller="Settings" asp-action="Index" class="@(current == "Settings" ? "mm-active" : "")">
                                    <i class="metismenu-icon pe-7s-settings"></i>
                                    Settings
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="app-main__outer">
                <div class="app-main__inner">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <div class="app-wrapper-footer">
                    <div class="app-footer">
                        <div class="app-footer__inner">
                            <div class="app-footer-left">
                                <ul class="nav">
                                    <li class="nav-item">
                                        <span class="nav-link">Built with ASP.NET Core MVC &amp; SQL Server</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="app-footer-right">
                                <ul class="nav">
                                    <li class="nav-item">
                                        <span class="nav-link">&copy; 2026 Order Management System</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>