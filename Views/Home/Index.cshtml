@model OrderManagementSystem.ViewModels.StatsViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h2 class="mb-0">Dashboard</h2>
    <small class="text-muted">Order Management System Overview</small>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-primary"><div class="card-body">
            <div>Total Orders</div>
            <h2 class="mb-0">@Model.TotalOrders</h2>
        </div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-info"><div class="card-body">
            <div>Total Revenue <small>(excl. cancelled)</small></div>
            <h2 class="mb-0">EGP @Model.TotalRevenue.ToString("N2")</h2>
        </div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-dark bg-warning"><div class="card-body">
            <div>Pending Orders</div>
            <h2 class="mb-0">@Model.PendingOrders</h2>
        </div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-success"><div class="card-body">
            <div>Delivered Orders</div>
            <h2 class="mb-0">@Model.DeliveredOrders</h2>
        </div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-dark"><div class="card-body">
            <div>Total Customers</div>
            <h2 class="mb-0">@Model.TotalCustomers</h2>
        </div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-white bg-danger"><div class="card-body">
            <div>Products <small>(@Model.LowStockProducts low / out of stock)</small></div>
            <h2 class="mb-0">@Model.TotalProducts</h2>
        </div></div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Sales Report <small class="text-muted">(last 6 months)</small></h5>
            <div style="position:relative;height:300px"><canvas id="salesChart"></canvas></div>
        </div></div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Orders by Status</h5>
            <div style="position:relative;height:300px"><canvas id="statusChart"></canvas></div>
        </div></div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-3">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Top Categories</h5>
            <table class="table table-sm mb-0">
                @foreach (var c in Model.TopCategories)
                {
                    <tr><td>@c.Label</td><td class="text-end">EGP @c.Value.ToString("N2")</td></tr>
                }
                @if (!Model.TopCategories.Any())
                {
                    <tr><td class="text-muted">No data yet.</td></tr>
                }
            </table>
        </div></div>
    </div>
    <div class="col-lg-8 mb-3">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Recent Orders</h5>
            <table class="table table-sm mb-0">
                <thead><tr><th>#</th><th>Date</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var o in Model.RecentOrders)
                {
                    var badge = o.Status switch
                    {
                        "Pending" => "bg-warning text-dark",
                        "Shipped" => "bg-info",
                        "Delivered" => "bg-success",
                        "Cancelled" => "bg-danger",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td>@o.OrderId</td>
                        <td>@o.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@o.CustomerName</td>
                        <td>@o.ProductName</td>
                        <td>EGP @o.Total.ToString("N2")</td>
                        <td><span class="badge @badge">@o.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">View all orders</a>
        </div></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('salesChart'), {
        type: 'bar',
        data: {
            labels: @Json.Serialize(Model.MonthlySales.Select(x => x.Label)),
            datasets: [{
                label: 'Revenue (EGP)',
                data: @Json.Serialize(Model.MonthlySales.Select(x => x.Value)),
                backgroundColor: '#3f6ad8'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Pending', 'Shipped', 'Delivered', 'Cancelled'],
            datasets: [{
                data: @Json.Serialize(new[] { Model.PendingOrders, Model.ShippedOrders, Model.DeliveredOrders, Model.CancelledOrders }),
                backgroundColor: ['#f7b924', '#16aaff', '#3ac47d', '#d92550']
            }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });
</script>
